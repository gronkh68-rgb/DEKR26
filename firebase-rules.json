{
  "rules": {
    ".read": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)",
    "devices": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === 'ADMIN_UID' || (auth.uid === $uid && !data.exists() && newData.child('ok').val() !== true && (!root.child('settings').child('regcode').exists() || newData.child('code').val() === root.child('settings').child('regcode').val())))"
      }
    },
    "tasks": {
      ".write": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)"
    },
    "msgs": {
      ".write": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)"
    },
    "kisten": {
      ".write": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)"
    },
    "orders": {
      ".write": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)"
    },
    "problems": {
      ".write": "auth != null && (auth.uid === 'ADMIN_UID' || root.child('devices').child(auth.uid).child('ok').val() === true)"
    },
    "layout": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "qrs": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "podests": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "settings": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    }
  }
}
